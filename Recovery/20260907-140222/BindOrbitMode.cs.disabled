using System;
using System.IO;
using UnityEditor;
using UnityEditor.Events;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.UI;
public static class BindOrbitMode
{
 [InitializeOnLoadMethod] static void Init(){if(File.Exists("Temp/bind-orbit.request"))EditorApplication.delayCall+=Apply;}
 static void Labels(GameObject root){foreach(var t in root.GetComponentsInChildren<Text>(true)){
 if(t.transform.parent.name=="ShootingToggleButton") {t.text="MODE: NORMAL AIM";t.fontSize=36;}
 if(t.name=="Hint"){t.text="PRESS TO SWITCH AIM MODE";t.fontSize=25;}
 }}
 static void Apply(){
 if(EditorApplication.isCompiling||EditorApplication.isUpdating||EditorApplication.isPlayingOrWillChangePlaymode){EditorApplication.delayCall+=Apply;return;}
 if(!File.Exists("Temp/bind-orbit.request"))return;File.Delete("Temp/bind-orbit.request");
 try{
 var scene=SceneManager.GetSceneByPath("Assets/TheRoom/Scenes/TheRoom.unity");if(!scene.isLoaded)throw new Exception("Open scene first");
 GenerateBullet shooter=null;Transform planet=null;Button button=null;
 foreach(var root in scene.GetRootGameObjects())foreach(var t in root.GetComponentsInChildren<Transform>(true)){
 if(t.name=="Planet")planet=t;if(t.GetComponent<GenerateBullet>()!=null&&t.gameObject.activeInHierarchy)shooter=t.GetComponent<GenerateBullet>();if(t.name=="ShootingToggleButton")button=t.GetComponent<Button>();}
 if(shooter==null||planet==null||button==null)throw new Exception("Missing shooter, planet or mode button");
 var prefab=PrefabUtility.LoadPrefabContents("Assets/TheRoom/Prefabs/Nature_Console.prefab");try{Labels(prefab);PrefabUtility.SaveAsPrefabAsset(prefab,"Assets/TheRoom/Prefabs/Nature_Console.prefab");}finally{PrefabUtility.UnloadPrefabContents(prefab);}
 Labels(button.GetComponentInParent<Canvas>().gameObject);
 shooter.planet=planet;shooter.modeLabel=button.GetComponentInChildren<Text>();shooter.orbitAssist=false;shooter.RefreshLabel();
 bool bound=false;for(int i=0;i<button.onClick.GetPersistentEventCount();i++)if(button.onClick.GetPersistentTarget(i)==shooter&&button.onClick.GetPersistentMethodName(i)=="ToggleOrbitAssist")bound=true;
 if(!bound)UnityEventTools.AddPersistentListener(button.onClick,shooter.ToggleOrbitAssist);
 if(shooter.bulletPrefab==null||shooter.initPos==null)throw new Exception("Shooter missing original prefab or firepoint");
 var bp=AssetDatabase.GetAssetPath(shooter.bulletPrefab);var bulletRoot=PrefabUtility.LoadPrefabContents(bp);try{foreach(var t in bulletRoot.GetComponentsInChildren<Transform>(true))t.gameObject.isStatic=false;PrefabUtility.SaveAsPrefabAsset(bulletRoot,bp);}finally{PrefabUtility.UnloadPrefabContents(bulletRoot);}
 // Check tangent fallback and circular-speed identity without invoking input or firing.
 foreach(var forward in new[]{Vector3.right,Vector3.forward}){var v=GenerateBullet.OrbitVelocity(Vector3.right*3,forward,Vector3.up,1.5f);if(Mathf.Abs(Vector3.Dot(v,Vector3.right))>0.0001f||Mathf.Abs(v.sqrMagnitude-.5f)>.0001f)throw new Exception("Orbit initial velocity test failed");}
 shooter.ToggleOrbitAssist();if(!shooter.orbitAssist||!shooter.modeLabel.text.Contains("ORBIT"))throw new Exception("Toggle failed");shooter.ToggleOrbitAssist();
 EditorUtility.SetDirty(shooter);EditorUtility.SetDirty(button);PrefabUtility.RecordPrefabInstancePropertyModifications(button);PrefabUtility.RecordPrefabInstancePropertyModifications(shooter.modeLabel);
 EditorSceneManager.MarkSceneDirty(scene);EditorSceneManager.SaveScene(scene);AssetDatabase.SaveAssets();File.WriteAllText("Previews/orbit-mode-validation.txt","PASS: controller shooter references preserved; Planet assigned; mode Button persistent listener bound; mode text toggles both ways; tangent and radial-aim fallback tests pass; Bullet prefab non-static.");
 }catch(Exception e){File.WriteAllText("Previews/orbit-mode-error.txt",e.ToString());Debug.LogException(e);}
 }
}
