using System;
using System.IO;
using System.Linq;
using UnityEditor;
using UnityEditor.Events;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;
public static class BakeButtonFeedback
{
 const string Dir="Recovery/native-feedback/";
 [InitializeOnLoadMethod] static void Init(){if(File.Exists(Dir+"request"))EditorApplication.delayCall+=Run;}
 static void Run(){
 if(EditorApplication.isCompiling||EditorApplication.isUpdating||EditorApplication.isPlayingOrWillChangePlaymode){EditorApplication.delayCall+=Run;return;}
 if(!File.Exists(Dir+"request"))return;
 File.Move(Dir+"request",Dir+"running");
 try{
 var scene=SceneManager.GetActiveScene();
 if(scene.path!="Assets/TheRoom/Scenes/TheRoom.unity")throw new Exception("Active scene is not TheRoom; no scene modified.");
 if(!EditorSceneManager.SaveScene(scene,Dir+"LiveBefore.unity",true))throw new Exception("Backup failed");
 var roots=scene.GetRootGameObjects();
 var shooter=roots.SelectMany(r=>r.GetComponentsInChildren<GenerateBullet>(true)).Single(g=>g.bulletPrefab!=null&&g.initPos!=null&&g.planet!=null);
 var buttons=roots.SelectMany(r=>r.GetComponentsInChildren<Button>(true)).ToArray();
 var toggle=buttons.Single(b=>b.name=="ShootingToggleButton");
 var outline=toggle.transform.Find("RaisedButton/VertexOutline");
 if(outline==null)throw new Exception("Outline missing");
 var mat=AssetDatabase.LoadAssetAtPath<Material>("Packages/com.unity.render-pipelines.universal/Runtime/Materials/ParticlesUnlit.mat");
 var clip=AssetDatabase.LoadAssetAtPath<AudioClip>("Assets/TheRoom/Resources/Feedback/Click.ogg");
 if(mat==null||clip==null)throw new Exception("Feedback assets missing");
 shooter.outline=outline;
 for(int i=toggle.onClick.GetPersistentEventCount()-1;i>=0;i--){
 var target=toggle.onClick.GetPersistentTarget(i);var method=toggle.onClick.GetPersistentMethodName(i);
 if(target is MonoScript||(target!=null&&target.GetType().Name=="TangentAssist")||method=="switchMode"||method=="ToggleAssist")UnityEventTools.RemovePersistentListener(toggle.onClick,i);
 }
 UnityEventTools.AddPersistentListener(toggle.onClick,shooter.switchMode);
 foreach(var button in buttons){
 var old=button.GetComponent<RoomButtonFeedback>();if(old!=null)UnityEngine.Object.DestroyImmediate(old);
 var existing=button.transform.Find("ClickFeedback");if(existing!=null)throw new Exception("Already baked: "+button.name);
 var g=new GameObject("ClickFeedback");g.transform.SetParent(button.transform,false);
 var rect=button.transform as RectTransform;
 g.transform.position=(rect!=null?rect.TransformPoint(rect.rect.center):button.transform.position)-button.transform.forward*.035f;
 g.transform.rotation=Quaternion.LookRotation(-button.transform.forward,button.transform.up);
 var scale=button.transform.lossyScale;g.transform.localScale=new Vector3(1f/Mathf.Abs(scale.x),1f/Mathf.Abs(scale.y),1f/Mathf.Abs(scale.z));
 var ps=g.AddComponent<ParticleSystem>();ps.Stop(true,ParticleSystemStopBehavior.StopEmittingAndClear);
 var main=ps.main;main.playOnAwake=false;main.loop=false;main.duration=.4f;main.startLifetime=.3f;main.startSpeed=.35f;main.startSize=.025f;main.startColor=new Color(.15f,.7f,1f,1);main.maxParticles=32;main.scalingMode=ParticleSystemScalingMode.Local;main.simulationSpace=ParticleSystemSimulationSpace.World;
 var emission=ps.emission;emission.rateOverTime=0;emission.SetBursts(new[]{new ParticleSystem.Burst(0,12)});
 var shape=ps.shape;shape.shapeType=ParticleSystemShapeType.Cone;shape.angle=65;shape.radius=.035f;
 var col=ps.colorOverLifetime;col.enabled=true;var grad=new Gradient();grad.SetKeys(new[]{new GradientColorKey(Color.white,0),new GradientColorKey(Color.white,1)},new[]{new GradientAlphaKey(1,0),new GradientAlphaKey(0,1)});col.color=grad;
 ps.GetComponent<ParticleSystemRenderer>().sharedMaterial=mat;
 var audio=g.AddComponent<AudioSource>();audio.playOnAwake=false;audio.clip=clip;audio.spatialBlend=1;audio.dopplerLevel=0;audio.volume=.45f;audio.minDistance=1;audio.maxDistance=18;audio.rolloffMode=AudioRolloffMode.Logarithmic;
 UnityEventTools.AddPersistentListener(button.onClick,ps.Play);
 UnityEventTools.AddPersistentListener(button.onClick,audio.Play);
 EditorUtility.SetDirty(button);PrefabUtility.RecordPrefabInstancePropertyModifications(button);
 }
 EditorUtility.SetDirty(shooter);PrefabUtility.RecordPrefabInstancePropertyModifications(shooter);
 EditorSceneManager.MarkSceneDirty(scene);
 if(!EditorSceneManager.SaveScene(scene))throw new Exception("Scene save failed");
 foreach(var b in buttons){if(b.transform.Find("ClickFeedback")==null)throw new Exception("Missing feedback");}
 File.WriteAllText(Dir+"success.txt","Saved current active scene. Buttons="+buttons.Length+". switchMode target="+shooter.name+". Native ParticleSystem.Play and AudioSource.Play bound; no runtime button generation.");
 }catch(Exception e){File.WriteAllText(Dir+"error.txt",e.ToString());Debug.LogException(e);}
 }
}
