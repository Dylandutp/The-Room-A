using System;using System.IO;using System.Linq;using UnityEngine;using UnityEngine.UI;using UnityEngine.Events;using UnityEngine.SceneManagement;using UnityEditor;using UnityEditor.SceneManagement;
public static class SetupPC03Music{
 [InitializeOnLoadMethod]static void Init(){if(File.Exists("Recovery/pc03-music/finish.request"))EditorApplication.delayCall+=Run;}
 static void Run(){if(EditorApplication.isCompiling||EditorApplication.isUpdating||EditorApplication.isPlayingOrWillChangePlaymode){EditorApplication.delayCall+=Run;return;}if(!File.Exists("Recovery/pc03-music/finish.request"))return;File.Delete("Recovery/pc03-music/finish.request");try{
 var scene=SceneManager.GetActiveScene();if(scene.path!="Assets/TheRoom/Scenes/TheRoom.unity")throw new Exception("Unexpected scene");var pc=scene.GetRootGameObjects().SelectMany(r=>r.GetComponentsInChildren<Transform>(true)).Single(t=>t.name=="PC_03");var toggle=pc.GetComponentInChildren<Toggle>(true);var music=pc.Find("CafeMusic").gameObject;
 toggle.SetIsOnWithoutNotify(false);toggle.onValueChanged.SetPersistentListenerState(0,UnityEventCallState.EditorAndRuntime);toggle.isOn=true;if(!music.activeSelf)throw new Exception("On failed");toggle.isOn=false;if(music.activeSelf)throw new Exception("Off failed");toggle.onValueChanged.SetPersistentListenerState(0,UnityEventCallState.RuntimeOnly);
 foreach(var t in pc.GetComponentsInChildren<Text>(true))if(t.text.StartsWith("CAFE MUSIC"))t.text="MUSIC: PLAY / STOP";
 EditorUtility.SetDirty(toggle);EditorSceneManager.MarkSceneDirty(scene);if(!EditorSceneManager.SaveScene(scene))throw new Exception("Save failed");File.WriteAllText("Recovery/pc03-music/success.txt","PC03 Toggle dynamic bool SetActive tested on/off. Looping 3D music starts disabled. Original click feedback retained. No runtime script added. Saved.");
 }catch(Exception e){File.WriteAllText("Recovery/pc03-music/finish-error.txt",e.ToString());}}
}
