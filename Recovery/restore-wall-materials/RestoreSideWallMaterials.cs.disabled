using System;using System.IO;using System.Linq;using UnityEngine;using UnityEngine.SceneManagement;using UnityEditor;using UnityEditor.SceneManagement;
public static class RestoreSideWallMaterials{
 const string D="Recovery/restore-wall-materials/";
 [InitializeOnLoadMethod]static void Init(){if(File.Exists(D+"request"))EditorApplication.delayCall+=Run;}
 static void Run(){if(EditorApplication.isCompiling||EditorApplication.isUpdating||EditorApplication.isPlayingOrWillChangePlaymode){EditorApplication.delayCall+=Run;return;}if(!File.Exists(D+"request"))return;File.Move(D+"request",D+"running2");try{
 var scene=SceneManager.GetActiveScene();if(scene.path!="Assets/TheRoom/Scenes/TheRoom.unity")throw new Exception("Unexpected active scene");
 var rs=scene.GetRootGameObjects().SelectMany(r=>r.GetComponentsInChildren<MeshRenderer>(true)).ToArray();var west=rs.Single(r=>r.name=="West_Wall");var east=rs.Single(r=>r.name=="East_Wall");
 if(!EditorSceneManager.SaveScene(scene,D+"LiveBefore.unity",true))throw new Exception("Backup failed");
 var tile=AssetDatabase.LoadAssetAtPath<Texture2D>("Assets/TheRoom/ExtraMaterials/tile.png");var path="Assets/TheRoom/ExtraMaterials/tile-normal.png";var importer=AssetImporter.GetAtPath(path) as TextureImporter;if(tile==null||importer==null)throw new Exception("Course textures missing");if(importer.textureType!=TextureImporterType.NormalMap){importer.textureType=TextureImporterType.NormalMap;importer.SaveAndReimport();}var normal=AssetDatabase.LoadAssetAtPath<Texture2D>(path);
 var report="";for(int i=0;i<2;i++){var r=i==0?west:east;var mat=AssetDatabase.LoadAssetAtPath<Material>("Assets/TheRoom/Materials/WallMaterial"+(i+1)+".mat");report+=r.name+" previous="+r.sharedMaterial+"\n";mat.shader=Shader.Find("Universal Render Pipeline/Lit");mat.SetTexture("_BaseMap",tile);mat.SetTexture("_BumpMap",normal);mat.SetColor("_BaseColor",Color.white);mat.SetFloat("_BumpScale",1);mat.EnableKeyword("_NORMALMAP");mat.SetFloat("_Metallic",i==0?.15f:.65f);mat.SetFloat("_Smoothness",i==0?.25f:.75f);var tiling=Vector2.one*(i==0?8:4);mat.SetTextureScale("_BaseMap",tiling);mat.SetTextureScale("_BumpMap",tiling);r.sharedMaterial=mat;EditorUtility.SetDirty(mat);EditorUtility.SetDirty(r);PrefabUtility.RecordPrefabInstancePropertyModifications(r);if(r.sharedMaterial.GetTexture("_BaseMap")!=tile||!mat.IsKeywordEnabled("_NORMALMAP"))throw new Exception("Verification failed");}
 AssetDatabase.SaveAssets();EditorSceneManager.MarkSceneDirty(scene);if(!EditorSceneManager.SaveScene(scene))throw new Exception("Save failed");File.WriteAllText(D+"success.txt",report+"Restored both side walls: course tile+normal, tiling 8/4, URP Lit normal keyword enabled. Saved.");
 }catch(Exception e){File.WriteAllText(D+"error.txt",e.ToString());}}
}
